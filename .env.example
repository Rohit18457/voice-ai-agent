# ==========================================
# Groq API Configuration
# Get your free API key at: https://console.groq.com
# ==========================================
GROQ_API_KEY=your_groq_api_key_here

# Fast, high-performance Groq LLM
GROQ_MODEL=qwen/qwen3.8-27b

# ==========================================
# Audio / Speech Recognition Settings
# ==========================================
# Ambient noise calibration duration in seconds
CALIBRATION_DURATION=1.0

# Silence duration before ending speech capture (seconds)
PAUSE_THRESHOLD=1.5

# Energy threshold for microphone sensitivity (0 for dynamic auto-adjust)
ENERGY_THRESHOLD=300

# ==========================================
# Text-To-Speech (TTS) Settings
# ==========================================
# Speech rate in words per minute (Default: 175)
TTS_RATE=175

# Volume level (0.0 to 1.0)
TTS_VOLUME=1.0

# Voice Index (0 for male / default, 1 for female on most Windows systems)
TTS_VOICE_INDEX=0
